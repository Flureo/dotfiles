{
    "layer": "top",
    "position": "top",
    "height": "auto",
	"margin": "4",
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
		"hyprland/window",
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "battery",
        "tray",
        "clock"
    ],
	"hyprland/window": {
		"format": "{title}",
		"icon": true,
		"icon-size": 18,
	},
	"hyprland/workspaces": {
		"disable-scroll": true,
		"all-outputs": true,
		"warp-on-scroll": false,
		"format": "{name}",
		"format-icons": {
			"urgent": "",
			"focused": "",
			"default": ""
		}
	},
    "tray": {
		"icon-size": 18,
        "spacing": 10
    },
    "clock": {

    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        "format-wifi": "",
        "format-ethernet": "󰛳",
        "format-disconnected": "󰲛",
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "{format_source}",
        "format-icons": {
            "default": [" ", " ", " "]
        },
        "on-click": "pavucontrol"
    }
}
